# Sanity (required only for import + reading from CMS)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
SANITY_TOKEN=  # write token with dataset access (for import)

# Web (optional)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SITE_URL=https://chinaislandgrill.com

# Restaurant config
NEXT_PUBLIC_RESTAURANT_PHONE=
NEXT_PUBLIC_RESTAURANT_ADDRESS=
NEXT_PUBLIC_ORDER_CART_URL=https://us.chinesemenu.com/order/shoppingcart.htm

# Stripe (Required for payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
