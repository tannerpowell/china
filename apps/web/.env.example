# Sanity CMS Configuration (Required)
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id

# Restaurant Configuration (Optional — code falls back to verified values in src/lib/restaurant.ts)
# China Island Asian Grill, 6101 Long Prairie Rd Ste 740, Flower Mound, TX 75028
NEXT_PUBLIC_RESTAURANT_ADDRESS=
NEXT_PUBLIC_RESTAURANT_HOURS="Sun–Thu: 11 a.m. – 9 p.m. | Fri–Sat: 11 a.m. – 9:30 p.m."
NEXT_PUBLIC_RESTAURANT_PHONE=

# Google Analytics 4 (Optional — leave blank to disable)
# Get an ID at analytics.google.com → Admin → Data Streams, then set it in
# Vercel → Project → Settings → Environment Variables and redeploy.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification (Optional)
# Search Console → Settings → Verification → HTML tag; paste the content
# value here and add <meta name="google-site-verification" content="..." />
# to src/app/layout.tsx.
# GOOGLE_SITE_VERIFICATION=

# Stripe (Required for payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
